{
  "name": "media-ref",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run @media-ref/website#dev",
    "db:up": "vp run @media-ref/db#up",
    "db:down": "vp run @media-ref/db#down",
    "db:migrate": "vp run @media-ref/db#migrate",
    "proto:lint": "buf lint",
    "proto:gen": "buf generate && vp fmt packages/client/src/gen apps/api/src/gen",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@bufbuild/protoplugin": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@bufbuild/protoplugin": "^2.17.0",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "kysely": "^0.29.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0",
    "wrangler": "^4.167.0"
  }
}
