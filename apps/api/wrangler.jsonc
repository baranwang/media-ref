{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-ref-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "api.mediaref.org",
      "custom_domain": true,
    },
  ],
  "vars": {
    "API_BASE_URL": "https://api.mediaref.org",
    "COOKIE_DOMAIN": "mediaref.org",
    "TRUSTED_ORIGINS": "https://mediaref.org,https://www.mediaref.org",
    "EMAIL_FROM": "noreply@mediaref.org",
    // Account that owns the API_USAGE dataset; queried with the ANALYTICS_API_TOKEN secret.
    "CF_ACCOUNT_ID": "9c578ed9cad837fb4a2564db7b36b483",
  },
  "analytics_engine_datasets": [
    {
      "binding": "API_USAGE",
      "dataset": "media_ref_api_usage",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@mediaref.org"],
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_READ",
      "id": "a41d601604184b8cacfad0efa39920c6",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/media_ref_dev",
    },
    {
      "binding": "HYPERDRIVE_WRITE",
      "id": "ec209a2e573947d0bffa6ee0e5b7f4cc",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/media_ref_dev",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER_READ_KEY",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMITER_READ_IP",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
  ],
}
