{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-ref-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "vars": {
    "EXPLORATION_DAILY_BUDGET": "0",
    "ENABLE_DAILY_TMDB_EXPORTS_SYNC": "false",
    // Bilibili answers HTTP 412 to Cloudflare egress IPs; send it out of greencloud-hk instead.
    "OUTBOUND_PROXY_CONFIG": "{\"bilibili\":{\"mode\":\"egress\"}}",
  },
  // greencloud-hk-egress: HTTPS relay on the HK machine, through the greencloud-hk tunnel.
  "vpc_services": [
    {
      "binding": "EGRESS",
      "service_id": "01a213a3-59c6-7e81-a8b6-ad2102f53bbd",
      "remote": true,
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_WRITE",
      "id": "ec209a2e573947d0bffa6ee0e5b7f4cc",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/media_ref_dev",
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "media-ref-jobs",
        "binding": "JOBS_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "media-ref-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "ai": {
    "binding": "AI",
  },
}
