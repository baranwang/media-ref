{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-ref-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "vars": {
    // Demands explored per UTC day. With one job per minute the cron runs at most 1440 a day, so
    // this no longer caps by count; EXPLORATION_DAILY_TOKEN_BUDGET still bounds model spend.
    "EXPLORATION_DAILY_BUDGET": "2000",
    // One exploration job per cron tick: queue messages run one after another in one consumer
    // invocation (15-minute wall clock), and a job may take up to its 5-minute budget.
    "EXPLORATION_BATCH_SIZE": "1",
    // Change requests the review agent reviews with a model per UTC day (ADR 0003). Beyond it they
    // wait for the next day; nothing is left for a person (CONSTITUTION.md).
    "REVIEW_AGENT_DAILY_BUDGET": "200",
    "ENABLE_DAILY_TMDB_EXPORTS_SYNC": "false",
    // Exploration agent model: a magpie routing group, through HK (MAGPIE_GATEWAY_KEY secret).
    // Without that secret the worker falls back to AI Gateway (AI_GATEWAY_ID) over the AI binding.
    "AI_MODEL": "group/cheap-first",
    "AI_GATEWAY_ID": "gateway",
    // Bilibili answers HTTP 412 and Youku its CAPTCHA to Cloudflare egress IPs; send them out of
    // greencloud-hk instead.
    "OUTBOUND_PROXY_CONFIG": "{\"bilibili\":{\"mode\":\"egress\"},\"youku\":{\"mode\":\"egress\"}}",
  },
  // greencloud-hk-gateway: the HK machine's Caddy, through the greencloud-hk tunnel. It relays
  // outbound HTTPS (x-egress-host) and serves magpie (x-hk-service: magpie).
  "vpc_services": [
    {
      "binding": "HK",
      "service_id": "01a213a3-59c6-7e81-a8b6-ad2102f53bbd",
      "remote": true,
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_WRITE",
      "id": "ec209a2e573947d0bffa6ee0e5b7f4cc",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/media_ref_dev",
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "media-ref-jobs",
        "binding": "JOBS_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "media-ref-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "ai": {
    "binding": "AI",
  },
}
