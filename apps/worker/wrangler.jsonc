{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-ref-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_WRITE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/media_ref_dev",
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "media-ref-jobs",
        "binding": "JOBS_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "media-ref-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "ai": {
    "binding": "AI",
  },
}
